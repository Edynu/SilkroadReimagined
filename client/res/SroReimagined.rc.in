// The players' build's version resource (made by CMake from SR_CLIENT_VERSION): what Windows shows in the file's
// properties.
#include <winres.h>

// The exe's icon (Explorer, the taskbar, the window: SDL takes the exe's first icon).
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/res/SroReimagined.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @SR_VERSION_MAJOR@,@SR_VERSION_MINOR@,@SR_VERSION_PATCH@,0
 PRODUCTVERSION  @SR_VERSION_MAJOR@,@SR_VERSION_MINOR@,@SR_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SroReimagined contributors"
            VALUE "FileDescription",  "SroReimagined"
            VALUE "FileVersion",      "@SR_CLIENT_VERSION@"
            VALUE "InternalName",     "SroReimagined"
            VALUE "LegalCopyright",   "SroReimagined contributors, AGPL-3.0-or-later"
            VALUE "OriginalFilename", "SroReimagined.exe"
            VALUE "ProductName",      "SroReimagined"
            VALUE "ProductVersion",   "@SR_CLIENT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
